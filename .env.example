# Configuracion del servicio de comercio.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-commerce
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3005
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI. Deshabilitada en produccion por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory: repositorio en proceso, suficiente para desarrollo y pruebas.
# postgres: requiere ADR-005 aprobado y DATABASE_URL informado.
PERSISTENCE_DRIVER=memory
DATABASE_URL=

# --- Integracion con Catalog ----------------------------------------------
# El adaptador HTTP hacia Catalog depende de ADR-006. Mientras tanto opera el
# catalogo local de precios. Este servicio NUNCA accede a la base de datos de
# Catalog: consulta precios por su API.
